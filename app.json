{
  "expo": {
    "name": "Scene",
    "slug": "scene-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sceneapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
  "supportsTablet": true,
  "bundleIdentifier": "com.scenesa.app",
  "buildNumber": "3",
  "entitlements": {
    "aps-environment": "production"
  },
  "infoPlist": {
    "LSApplicationQueriesSchemes": [
      "instagram"
    ],
    "NSPhotoLibraryUsageDescription": "Scene needs access to your photos so you can upload avatars, review images, list covers, and share your favorite moments in the app.",
    "NSPhotoLibraryAddUsageDescription": "Scene needs permission to save review cards and shareable images to your photo library."
  }
},
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.scenesa.app",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1279194555922916~xxxxxxxxxx",
          "iosAppId": "ca-app-pub-1279194555922916~9429450536"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "backendUrl": "https://backend.scenesa.com",
      "router": {},
      "eas": {
        "projectId": "08079b1d-6a14-4e77-88ab-2d59684636ce"
      }
    }
  }
}
