// SCENE_PROFILE_APP_PARITY_BATCH1 — web adaptation of native ProfileHeader.
import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import toast from "react-hot-toast";
import useTranslate from "../../utils/useTranslate";
import "../../styles/scene-profile-app-parity.css";
const AVATAR = "/default-avatar.jpg";
const BACKDROP = "/default-backdrop.jpg";
export default function ProfileHeader({user, logs = [], isOwner, isFollowing, handleFollow, handleRemoveFollower, mode = "movies", onModeChange}) {
  const navigate = useNavigate();
  const t = useTranslate();
  const [menuOpen,setMenuOpen] = useState(false);
  const [avatarOpen,setAvatarOpen] = useState(false);
  const [me,setMe] = useState(null);
  useEffect(()=>{try { setMe(JSON.parse(localStorage.getItem("user") || "null")); }catch {setMe(null);}}, []);
  useEffect(()=>{if(!avatarOpen)return;const key=e=>{if(e.key==="Escape")setAvatarOpen(false)};window.addEventListener("keydown",key);return()=>window.removeEventListener("keydown",key)},[avatarOpen]);
  const guest = !me?._id || !me?.token;
  const isTV = mode === "tv";
  const backdrop = (isTV ? user?.tvProfileBackdrop : user?.profileBackdrop) || BACKDROP;
  const filmCount = new Set((logs || []).map(l=>l?.tmdbId || l?.movie?.tmdbId || l?.movie?.id || l?.movieId).filter(Boolean)).size;
  const reportedCount = Number(user?.totalLogs ?? user?.totalFilms ?? user?.filmCount);
  const count = Number.isFinite(reportedCount) && reportedCount >= 0 ? reportedCount : filmCount;
  const showLogin = () => navigate(`/login?redirect=${encodeURIComponent(window.location.pathname+window.location.search)}`);
  const share = async()=>{const url=`${window.location.origin}/u/${encodeURIComponent(user?.username || "")}`;try{await navigator.clipboard.writeText(url);toast.success(t("Profile link copied!"))}catch{toast.error(t("Couldn’t copy link"))}setMenuOpen(false)};
  const canRemoveFollower = Boolean(me?._id && (user?.following||[]).some(x=>String(x)===String(me._id)));
  // SCENE_PROFILE_REPAIR_TV_V3: local profile view mode; no account preference write.
  const visibleMode = mode;
  const switchView = () => onModeChange?.(visibleMode === "tv" ? "movies" : "tv");
  const options = [
    ...(isOwner ? [{label:t("Edit Profile"),do:()=>navigate("/edit-profile")}] : []),
    {label:t("Share"),do:share},
    ...(isOwner ? [{label:t("Settings"),do:()=>navigate("/settings")}] : []),
    ...(!isOwner && canRemoveFollower ? [{label:t("Remove Follower"),do:()=>handleRemoveFollower?.(user._id)}] : []),
    {label:visibleMode === "tv" ? t("Switch to Movies") : t("Switch to TV"),do:switchView},
  ];
  return <header className="scene-native-header">
    <div className="scene-profile-mode-strip"><button type="button" onClick={switchView} disabled={!onModeChange} title={!onModeChange ? "TV profile requires the TV-mode web integration" : "Switch profile mode"}>{visibleMode === "tv" ? "🎬 Switch to Movies" : "📺 Switch to TV"}</button>{!onModeChange && <span>TV mode requires web integration</span>}</div>
    <div className="scene-native-backdrop" style={{backgroundImage:`linear-gradient(to bottom, transparent 4%, rgba(0,0,0,.08) 25%, rgba(0,0,0,.62) 70%, #0e0e0e 100%), url(${backdrop})`}}>
      {!isOwner && <button type="button" className="scene-native-back" onClick={()=>window.history.length>1?navigate(-1):navigate("/")} aria-label="Back">←</button>}
      <div className="scene-native-menu-wrap">
        <button type="button" className="scene-native-menu-trigger" onClick={()=>setMenuOpen(o=>!o)} aria-haspopup="menu" aria-expanded={menuOpen} aria-label="Profile options">⋯</button>
        {menuOpen && <><button type="button" className="scene-native-menu-shade" aria-label="Close menu" onClick={()=>setMenuOpen(false)}/><div className="scene-native-menu" role="menu">{options.map((o,i)=><button key={i} type="button" role="menuitem" onClick={()=>{setMenuOpen(false);o.do()}}>{o.label}</button>)}</div></>}
      </div>
      <button type="button" className="scene-native-avatar-btn" onClick={()=>setAvatarOpen(true)} aria-label="Enlarge profile photo"><img src={user?.avatar||AVATAR} alt={`${user?.username||"User"} avatar`} onError={e=>{e.currentTarget.onerror=null;e.currentTarget.src=AVATAR}} /></button>
    </div>
    <div className="scene-native-identity">
      <div className="scene-native-name"><div className="scene-native-display">{user?.name||""}</div><div className="scene-native-username">@{user?.username}</div></div>
      {!isOwner && <button type="button" className="scene-native-follow" onClick={()=>guest?showLogin():handleFollow?.(user._id)}>{isFollowing?t("Following"):t("Follow")}</button>}
    </div>
    {user?.bio && <p className="scene-native-bio">{user.bio}</p>}
    <div className="scene-native-counts">
      <button type="button" onClick={()=>guest?showLogin():navigate(`/profile/${user._id}/following`)}><strong>{user?.following?.length||0}</strong><span>{t("Following")}</span></button>
      <button type="button" onClick={()=>guest?showLogin():navigate(`/profile/${user._id}/followers`)}><strong>{user?.followers?.length||0}</strong><span>{t("Followers")}</span></button>
      <button type="button" onClick={()=>window.dispatchEvent(new CustomEvent("navigateToFilms"))}><strong>{count}</strong><span>{isTV?t("Shows"):t("Films")}</span></button>
    </div>
    {avatarOpen && <div className="scene-native-avatar-overlay" role="presentation" onClick={()=>setAvatarOpen(false)}><button type="button" className="scene-native-avatar-close" aria-label="Close enlarged photo" onClick={()=>setAvatarOpen(false)}>×</button><img src={user?.avatar||AVATAR} alt={`${user?.username||"User"} profile photo`} onClick={e=>e.stopPropagation()}/></div>}
  </header>;
}
