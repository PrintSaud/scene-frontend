html { scroll-behavior:smooth; }
body { margin:0; background:#050507; }
.scene-site-page { --purple:#a35cff; --purple2:#6f32d8; min-height:100vh; overflow:hidden; position:relative; background:#060608; color:#fff; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.scene-site-page * { box-sizing:border-box; }
.scene-site-page h1,.scene-site-page h2,.scene-site-page h3,.scene-site-page p { margin-top:0; }
.scene-site-grid { pointer-events:none; position:fixed; inset:0; opacity:.12; background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px); background-size:42px 42px; mask-image:linear-gradient(to bottom,black,transparent 70%); }
.scene-site-orb { pointer-events:none; position:absolute; border-radius:50%; filter:blur(110px); opacity:.17; }
.scene-site-orb-one { width:520px; height:520px; right:-180px; top:100px; background:#7f35f4; }
.scene-site-orb-two { width:420px; height:420px; left:-180px; top:1000px; background:#5317a7; }
.scene-site-nav { position:sticky; top:0; z-index:30; width:min(1180px,calc(100% - 40px)); min-height:76px; margin:0 auto; display:grid; grid-template-columns:1fr auto 1fr; gap:30px; align-items:center; border-bottom:1px solid rgba(255,255,255,.07); background:rgba(6,6,8,.72); backdrop-filter:blur(18px); }
.scene-site-brand { border:0; background:transparent; color:#fff; cursor:pointer; display:flex; align-items:center; gap:7px; padding:0; justify-self:start; font-size:20px; font-weight:900; letter-spacing:-.04em; }
.scene-site-brand-mark { font-size:16px; }
.scene-site-nav-links { display:flex; gap:26px; align-items:center; }
.scene-site-nav-links a,.scene-site-footer-links a { color:#8b8b95; text-decoration:none; font-size:12px; font-weight:700; transition:.2s ease; }
.scene-site-nav-links a:hover,.scene-site-footer-links a:hover { color:#fff; }
.scene-site-nav-actions { justify-self:end; display:flex; align-items:center; gap:8px; }
.scene-site-language,.scene-site-login-link,.scene-site-nav-cta,.scene-site-primary-cta,.scene-site-secondary-cta { border:0; cursor:pointer; font:inherit; }
.scene-site-language { min-height:38px; display:flex; align-items:center; gap:7px; padding:0 11px; border-radius:10px; color:#b4b4bd; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); font-size:11px; font-weight:800; }
.scene-site-login-link { padding:10px 12px; background:transparent; color:#b6b6bf; font-size:11px; font-weight:800; }
.scene-site-nav-cta,.scene-site-primary-cta { display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius:12px; color:#fff; background:linear-gradient(135deg,#9a4cff,#6c2fd4); font-size:11px; font-weight:900; box-shadow:0 12px 35px rgba(122,57,218,.25); }
.scene-site-nav-cta { min-height:40px; padding:0 15px; }
.scene-site-hero { position:relative; z-index:2; width:min(1180px,calc(100% - 40px)); min-height:760px; margin:0 auto; display:grid; grid-template-columns:.92fr 1.08fr; gap:54px; align-items:center; padding:86px 0 86px; }
.scene-site-hero-copy { max-width:590px; }
.scene-site-eyebrow { display:block; margin-bottom:14px; color:#a66dff; font-size:10px; font-weight:900; letter-spacing:.18em; }
.scene-site-hero h1 { margin-bottom:23px; font-size:clamp(54px,6vw,88px); line-height:.96; letter-spacing:-5px; }
.scene-site-hero h1 span { display:block; background:linear-gradient(90deg,#fff 0%,#b77cff 55%,#8650e8 100%); -webkit-background-clip:text; background-clip:text; color:transparent; }
.scene-site-hero-description,.scene-site-section-heading p,.scene-site-showcase-copy>p,.scene-site-personal-copy>p,.scene-site-social-band p,.scene-site-ai-section p,.scene-site-saudi-section p,.scene-site-event-card p,.scene-site-download-section>p { color:#8e8e98; line-height:1.75; font-size:14px; }
.scene-site-hero-description { max-width:550px; }
.scene-site-hero-actions { margin-top:30px; display:flex; flex-wrap:wrap; gap:10px; }
.scene-site-primary-cta { min-height:52px; padding:0 21px; }
.scene-site-secondary-cta { min-height:52px; padding:0 18px; border-radius:12px; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; color:#fff; background:#101014; border:1px solid rgba(255,255,255,.11); font-size:11px; font-weight:800; }
.scene-site-hero-proof { margin-top:29px; display:flex; flex-wrap:wrap; gap:18px; color:#787882; }
.scene-site-hero-proof div { display:flex; align-items:center; gap:7px; font-size:10px; font-weight:800; }
.scene-site-hero-proof svg { color:#a76bff; }
.scene-site-product-stage { position:relative; min-height:640px; perspective:1200px; }
.scene-site-stage-glow { position:absolute; width:470px; height:470px; left:50%; top:50%; transform:translate(-50%,-50%); border-radius:50%; background:#7728ec; filter:blur(115px); opacity:.28; }
.scene-site-mockup { display:block; width:100%; height:auto; border-radius:26px; filter:drop-shadow(0 32px 45px rgba(0,0,0,.5)); }
.scene-site-product-stage>.scene-site-mockup { position:absolute; top:48px; width:255px; transition:transform .35s ease; }
.scene-site-mockup-left { left:5px; transform:rotate(-7deg) translateY(28px); z-index:1; }
.scene-site-mockup-center { left:50%; transform:translateX(-50%) scale(1.08); z-index:3; }
.scene-site-mockup-right { right:5px; transform:rotate(7deg) translateY(28px); z-index:2; }
.scene-site-product-stage:hover .scene-site-mockup-left { transform:rotate(-5deg) translateY(20px) translateX(-7px); }
.scene-site-product-stage:hover .scene-site-mockup-right { transform:rotate(5deg) translateY(20px) translateX(7px); }
.scene-site-strip { position:relative; z-index:2; width:100%; border-top:1px solid rgba(255,255,255,.06); border-bottom:1px solid rgba(255,255,255,.06); background:rgba(255,255,255,.012); }
.scene-site-strip p { margin:0; padding:19px 20px; text-align:center; color:#73737d; font-size:11px; font-weight:700; letter-spacing:.04em; }
.scene-site-strip strong { color:#b276ff; }
.scene-site-section,.scene-site-showcase { position:relative; z-index:2; width:min(1120px,calc(100% - 40px)); margin:0 auto; padding:110px 0; scroll-margin-top:90px; }
.scene-site-section-heading { max-width:670px; margin-bottom:45px; }
.scene-site-section h2,.scene-site-showcase h2,.scene-site-social-band h2,.scene-site-download-section h2 { margin-bottom:16px; font-size:clamp(34px,4vw,56px); line-height:1.03; letter-spacing:-2.4px; }
.scene-site-feature-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
.scene-site-feature-card { min-height:240px; padding:27px; border-radius:22px; border:1px solid rgba(255,255,255,.075); background:linear-gradient(145deg,rgba(255,255,255,.03),rgba(255,255,255,.012)); }
.scene-site-feature-icon { width:42px; height:42px; border-radius:12px; display:grid; place-items:center; color:#b47bff; background:rgba(152,78,246,.1); border:1px solid rgba(168,103,255,.13); }
.scene-site-feature-card h3 { margin:35px 0 11px; font-size:17px; }
.scene-site-feature-card p { margin:0; color:#7e7e88; line-height:1.6; font-size:11px; }
.scene-site-showcase { display:grid; grid-template-columns:1fr 1fr; gap:85px; align-items:center; min-height:720px; }
.scene-site-showcase-visual { width:min(100%,390px); justify-self:center; padding:0 20px; position:relative; }
.scene-site-showcase-visual::before,.scene-site-personal-visual::before { content:""; position:absolute; inset:18% 10%; border-radius:50%; background:#732ce8; filter:blur(100px); opacity:.18; }
.scene-site-showcase-visual .scene-site-mockup,.scene-site-personal-visual .scene-site-mockup { position:relative; z-index:2; }
.scene-site-showcase-copy { max-width:510px; }
.scene-site-check-list { margin-top:27px; display:grid; grid-template-columns:1fr 1fr; gap:12px 18px; }
.scene-site-check-row { display:flex; align-items:center; gap:9px; color:#a0a0aa; font-size:11px; }
.scene-site-check-icon { width:23px; height:23px; flex:0 0 auto; border-radius:50%; display:grid; place-items:center; color:#b274ff; background:rgba(151,73,255,.1); }
.scene-site-personal-section { display:grid; grid-template-columns:1fr .8fr; gap:80px; align-items:center; }
.scene-site-personal-visual { max-width:330px; justify-self:center; position:relative; }
.scene-site-chip-grid { margin-top:24px; display:flex; flex-wrap:wrap; gap:8px; }
.scene-site-chip-grid span { padding:9px 12px; border-radius:999px; color:#aaaab4; background:rgba(255,255,255,.035); border:1px solid rgba(255,255,255,.07); font-size:10px; font-weight:700; }
.scene-site-social-band { position:relative; z-index:2; width:min(1120px,calc(100% - 40px)); margin:0 auto; padding:60px; border-radius:28px; display:grid; grid-template-columns:1.1fr .9fr; gap:50px; align-items:center; border:1px solid rgba(164,99,255,.14); background:linear-gradient(120deg,rgba(121,55,225,.12),rgba(255,255,255,.018) 60%),#0a0a0d; }
.scene-site-social-icons { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.scene-site-social-icons div { min-height:100px; border-radius:16px; background:rgba(255,255,255,.025); border:1px solid rgba(255,255,255,.07); display:flex; flex-direction:column; justify-content:center; align-items:center; gap:8px; color:#aa70ff; }
.scene-site-social-icons span { color:#92929b; font-size:10px; font-weight:700; text-align:center; }
.scene-site-ai-section { display:grid; grid-template-columns:.65fr 1.35fr; gap:75px; align-items:center; }
.scene-site-ai-orb { width:280px; height:280px; justify-self:center; border-radius:50%; display:grid; place-items:center; color:#caa8ff; border:1px solid rgba(180,119,255,.19); background:radial-gradient(circle at 50% 50%,rgba(137,64,237,.25),rgba(40,16,73,.08) 42%,rgba(255,255,255,.015) 65%); }
.scene-site-saudi-section { min-height:320px; display:grid; grid-template-columns:auto 1fr auto; gap:34px; align-items:center; padding-left:42px; padding-right:42px; border-radius:25px; border:1px solid rgba(255,255,255,.075); background:radial-gradient(circle at 0% 50%,rgba(33,128,82,.08),transparent 27%),rgba(255,255,255,.014); }
.scene-site-saudi-badge { width:70px; height:70px; border-radius:18px; display:grid; place-items:center; font-size:31px; border:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.025); }
.scene-site-globe { color:rgba(255,255,255,.08); }
.scene-site-event-section { padding-top:40px; padding-bottom:90px; }
.scene-site-event-card { border-radius:26px; padding:46px; min-height:300px; display:grid; grid-template-columns:1.25fr .75fr; align-items:center; gap:55px; border:1px solid rgba(170,103,255,.13); background:radial-gradient(circle at 88% 40%,rgba(139,75,245,.13),transparent 25%),#09090c; }
.scene-site-event-card h2 { font-size:clamp(30px,3.4vw,46px); }
.scene-site-event-meta { display:flex; flex-wrap:wrap; gap:36px; margin-top:26px; }
.scene-site-event-meta div { display:flex; flex-direction:column; gap:5px; }
.scene-site-event-meta span { color:#6f6f79; font-size:8px; letter-spacing:.13em; font-weight:900; }
.scene-site-event-meta strong { font-size:12px; }
.scene-site-pod-badge { width:210px; height:210px; justify-self:center; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1px solid rgba(174,110,255,.2); background:radial-gradient(circle,rgba(137,63,236,.12),rgba(15,15,18,.12) 65%); }
.scene-site-pod-badge small { color:#7c7c86; font-size:8px; letter-spacing:.15em; font-weight:900; }
.scene-site-pod-badge strong { margin:9px 0 6px; font-size:25px; }
.scene-site-pod-badge span { color:#ad72ff; font-size:9px; font-weight:800; }
.scene-site-download-section { position:relative; z-index:2; width:min(1120px,calc(100% - 40px)); margin:0 auto 70px; padding:90px 30px; border-radius:30px; text-align:center; border:1px solid rgba(166,102,255,.15); background:radial-gradient(circle at 50% 100%,rgba(127,55,237,.15),transparent 42%),#09090c; scroll-margin-top:90px; }
.scene-site-download-section>p { max-width:620px; margin:0 auto; }
.scene-site-download-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:10px; margin-top:28px; }
.scene-site-store-button { min-width:178px; height:54px; padding:0 15px; border-radius:13px; display:flex; align-items:center; justify-content:flex-start; gap:10px; text-decoration:none; color:#fff; background:#111115; border:1px solid rgba(255,255,255,.12); }
.scene-site-store-disabled { opacity:.55; cursor:default; }
.scene-site-store-icon { font-size:25px; }
.scene-site-play-triangle { font-size:18px; }
.scene-site-store-button>span:last-child { display:flex; flex-direction:column; align-items:flex-start; line-height:1.1; }
.scene-site-store-button small { color:#9999a2; font-size:7px; }
.scene-site-store-button strong { font-size:13px; margin-top:2px; }
.scene-site-web-cta { margin-top:20px; border:0; background:transparent; color:#a26af0; cursor:pointer; display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:800; }
.scene-site-footer { width:min(1120px,calc(100% - 40px)); margin:0 auto; min-height:115px; border-top:1px solid rgba(255,255,255,.07); display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:25px; }
.scene-site-footer-brand { display:flex; flex-direction:column; gap:5px; }
.scene-site-footer-brand strong { font-size:15px; }
.scene-site-footer-brand span,.scene-site-footer-copy { color:#666670; font-size:9px; }
.scene-site-footer-links { display:flex; gap:17px; }
.scene-site-footer-copy { justify-self:end; }
.scene-site-ar .scene-site-nav-cta svg,.scene-site-ar .scene-site-primary-cta svg,.scene-site-ar .scene-site-web-cta svg { transform:rotate(180deg); }
.scene-site-ar .scene-site-store-button>span:last-child { align-items:flex-end; }

@media (max-width:1080px) {
  .scene-site-nav { grid-template-columns:1fr auto; }
  .scene-site-nav-links { display:none; }
  .scene-site-hero { grid-template-columns:1fr; padding-top:72px; text-align:center; }
  .scene-site-hero-copy { margin:0 auto; }
  .scene-site-hero-actions,.scene-site-hero-proof { justify-content:center; }
  .scene-site-product-stage { width:min(700px,100%); margin:0 auto; }
  .scene-site-feature-grid { grid-template-columns:1fr 1fr; }
  .scene-site-showcase { gap:50px; }
  .scene-site-personal-section { gap:50px; }
  .scene-site-ai-section { grid-template-columns:1fr; gap:35px; text-align:center; }
}

@media (max-width:760px) {
  .scene-site-nav { width:min(100% - 26px,1180px); min-height:68px; }
  .scene-site-brand { font-size:18px; }
  .scene-site-login-link { display:none; }
  .scene-site-language { padding:0 9px; }
  .scene-site-nav-cta { padding:0 12px; }
  .scene-site-hero { width:min(100% - 28px,1180px); min-height:auto; padding:62px 0 56px; gap:25px; }
  .scene-site-hero h1 { font-size:clamp(43px,12.5vw,66px); letter-spacing:-3.3px; }
  .scene-site-hero-description { font-size:13px; }
  .scene-site-product-stage { min-height:420px; }
  .scene-site-product-stage>.scene-site-mockup { width:180px; top:32px; }
  .scene-site-mockup-left { left:-46px; transform:rotate(-6deg) translateY(30px) scale(.86); }
  .scene-site-mockup-center { transform:translateX(-50%) scale(1.02); }
  .scene-site-mockup-right { right:-46px; transform:rotate(6deg) translateY(30px) scale(.86); }
  .scene-site-section,.scene-site-showcase { width:min(100% - 28px,1120px); padding:78px 0; }
  .scene-site-feature-grid { grid-template-columns:1fr; }
  .scene-site-showcase { grid-template-columns:1fr; min-height:auto; gap:35px; }
  .scene-site-showcase-tv .scene-site-showcase-visual { order:2; }
  .scene-site-showcase-copy { text-align:center; margin:0 auto; }
  .scene-site-showcase-visual { width:min(86%,340px); }
  .scene-site-check-list { grid-template-columns:1fr; width:max-content; max-width:100%; margin-left:auto; margin-right:auto; text-align:start; }
  .scene-site-personal-section { grid-template-columns:1fr; text-align:center; }
  .scene-site-personal-visual { margin-top:22px; width:min(80%,310px); }
  .scene-site-chip-grid { justify-content:center; }
  .scene-site-social-band { width:min(100% - 28px,1120px); padding:38px 24px; grid-template-columns:1fr; text-align:center; }
  .scene-site-ai-orb { width:220px; height:220px; }
  .scene-site-saudi-section { width:min(100% - 28px,1120px); grid-template-columns:auto 1fr; padding:34px 24px; }
  .scene-site-globe { display:none; }
  .scene-site-event-card { grid-template-columns:1fr; padding:36px 24px; gap:32px; text-align:center; }
  .scene-site-event-meta { justify-content:center; }
  .scene-site-pod-badge { width:190px; height:190px; }
  .scene-site-download-section { width:min(100% - 28px,1120px); padding:70px 20px; }
  .scene-site-footer { width:min(100% - 28px,1120px); grid-template-columns:1fr; padding:28px 0; text-align:center; }
  .scene-site-footer-brand,.scene-site-footer-links { align-items:center; justify-content:center; flex-wrap:wrap; }
  .scene-site-footer-copy { justify-self:center; }
}


/* Scene logo branding */
.scene-site-brand-logo {
  display: block;
  width: 46px;
  height: 46px;
  object-fit: contain;
  border-radius: 12px;
}

.scene-site-footer-logo {
  display: block;
  width: 42px;
  height: 42px;
  object-fit: contain;
  border-radius: 11px;
  margin-bottom: 3px;
}

@media (max-width: 700px) {
  .scene-site-brand-logo {
    width: 40px;
    height: 40px;
  }

  .scene-site-footer-logo {
    width: 38px;
    height: 38px;
  }
}

/* SceneBot landing preview */
.scene-site-ai-visual {
  width: min(100%, 340px);
  justify-self: center;
  position: relative;
}

.scene-site-ai-visual::before {
  content: "";
  position: absolute;
  inset: 18% 8%;
  background: #732ce8;
  filter: blur(100px);
  opacity: .2;
  border-radius: 50%;
}

.scene-site-ai-visual .scene-site-mockup {
  position: relative;
  z-index: 2;
}

@media (max-width: 760px) {
  .scene-site-ai-visual {
    width: min(80%, 310px);
  }
}
