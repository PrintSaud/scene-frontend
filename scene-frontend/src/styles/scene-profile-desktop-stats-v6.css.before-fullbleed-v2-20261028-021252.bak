/* Scene desktop profile stats V6: visual-only, no authentication/data changes */
@media (min-width: 1100px) {
  .scene-public-profile .scene-native-header { position: relative; isolation: isolate; }
  .scene-public-profile .scene-native-backdrop { position: relative; }
  .scene-public-profile .scene-native-counts {
    position: absolute !important;
    top: clamp(255px, 26vw, 365px) !important;
    right: clamp(20px, 3vw, 48px) !important;
    left: auto !important;
    width: auto !important;
    max-width: 42% !important;
    margin: 0 !important;
    padding: 16px 20px !important;
    display: flex !important;
    justify-content: flex-end !important;
    gap: clamp(18px, 2.5vw, 42px) !important;
    background: rgba(12, 12, 16, .55) !important;
    border: 1px solid rgba(255,255,255,.10) !important;
    border-radius: 16px !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 3;
  }
  .scene-public-profile .scene-native-counts button { min-width: 62px; }
  .scene-public-profile .scene-native-counts strong { font-size: 23px; }
  .scene-public-profile .scene-native-counts span { font-size: 12px; }
}
@media (min-width: 1100px) and (max-width: 1300px) {
 .scene-public-profile .scene-native-counts {top: 290px !important;max-width: 48% !important;}
}
