/* Scene Signup v2 — self-contained, no changes to LoginPage.css */
.scene-signup-v2{--signup-purple:#9e4aff;position:relative;min-height:100svh;overflow:hidden;isolation:isolate;background:#07050c;color:#f9f8ff;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.scene-signup-v2 *{box-sizing:border-box}
.scene-signup-grid{position:absolute;inset:0;z-index:-3;pointer-events:none;background-image:linear-gradient(rgba(145,97,205,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(145,97,205,.075) 1px,transparent 1px);background-size:40px 40px;mask-image:linear-gradient(90deg,transparent 22%,black 95%)}
.scene-signup-ambient{position:absolute;z-index:-2;inset:0;background:radial-gradient(ellipse at 78% 65%,rgba(87,24,154,.23),transparent 48%)}
.scene-signup-wall{position:absolute;z-index:-2;left:-11%;top:9%;width:78%;height:92%;overflow:hidden;transform:rotate(-1deg);opacity:.75;display:flex;flex-direction:column;gap:13px;mask-image:linear-gradient(90deg,black 42%,transparent 100%)}
.scene-signup-poster-row{display:flex;gap:13px;width:max-content;height:32%;animation:sceneSignupSlide 75s linear infinite}
.scene-signup-poster-row:nth-child(2){transform:translateX(-130px);animation-direction:reverse;animation-duration:90s}
.scene-signup-poster-row:nth-child(3){animation-duration:80s}
.scene-signup-poster-row img{height:100%;aspect-ratio:2/3;width:auto;object-fit:cover;border-radius:14px;border:1px solid rgba(255,255,255,.1)}
.scene-signup-wall::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,rgba(7,5,12,.58),rgba(7,5,12,.25))}
@keyframes sceneSignupSlide{to{translate:-50% 0}}
.scene-signup-back{position:absolute;top:32px;left:38px;z-index:4;display:flex;align-items:center;gap:10px;border:1px solid #2c2637;border-radius:12px;padding:13px 16px;background:rgba(10,9,15,.74);color:#c6c1d1;font-size:13px;font-weight:650;cursor:pointer}
.scene-signup-back:hover{border-color:#9161ca;color:white}
.scene-signup-layout{min-height:100svh;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(440px,.85fr);align-items:center;gap:5%;width:100%;max-width:1650px;margin:0 auto;padding:110px 5.5% 55px}
.scene-signup-hero{min-height:460px;display:flex;flex-direction:column;justify-content:space-between;position:relative;z-index:1}
.scene-signup-brand{width:95px;max-height:56px;object-fit:contain;object-position:left center}
.scene-signup-hero-copy{max-width:660px;padding-bottom:8px}
.scene-signup-eyebrow{font-size:12px;font-weight:850;letter-spacing:.22em;color:#c477ff}
.scene-signup-hero h1{font-size:clamp(46px,5.2vw,80px);line-height:1.02;letter-spacing:-.065em;margin:12px 0 22px;font-weight:830;text-shadow:0 4px 32px rgba(0,0,0,.4)}
.scene-signup-hero h1 em{display:block;font-style:normal;color:#bd80ff}
.scene-signup-hero p{max-width:530px;color:#a8a2b6;line-height:1.7;font-size:15px}
.scene-signup-right{width:100%;max-width:520px;justify-self:end;position:relative;z-index:2}
.scene-signup-card{border:1px solid #352443;border-radius:28px;background:linear-gradient(160deg,rgba(22,18,29,.98),rgba(10,8,15,.98));box-shadow:0 28px 90px rgba(46,7,83,.25);padding:36px 37px 30px}
.scene-signup-card-header{text-align:center;margin-bottom:22px}
.scene-signup-kicker{color:#ae65ff;font-size:10px;letter-spacing:.28em;font-weight:900}
.scene-signup-card h2{font-size:30px;letter-spacing:-.055em;margin:12px 0 6px;font-weight:800}
.scene-signup-card-header p,.scene-signup-org-preview>p{color:#928b9d;font-size:13px;line-height:1.55;margin:0}
.scene-signup-error{border:1px solid rgba(253,104,125,.5);background:rgba(253,104,125,.1);padding:11px 13px;border-radius:10px;color:#ff9ba8;font-size:12px;margin-bottom:14px}
.scene-signup-form{display:flex;flex-direction:column;gap:14px}
.scene-signup-avatar-line{display:flex;align-items:center;gap:13px;padding:3px 0 5px}
.scene-signup-avatar{width:54px;height:54px;flex:none;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#c99afd;background:rgba(137,67,201,.12);border:1px dashed #9954d0;cursor:pointer;overflow:hidden}
.scene-signup-avatar img{height:100%;width:100%;object-fit:cover}
.scene-signup-avatar-line strong{display:block;font-size:13px;font-weight:700}
.scene-signup-avatar-line span{display:block;color:#948a9f;font-size:11px;margin-top:5px}
.scene-signup-field{display:flex;flex-direction:column;gap:7px;color:#aaa5b3;font-size:12px;font-weight:650}
.scene-signup-input-wrap{display:flex;align-items:center;gap:11px;height:49px;background:rgba(255,255,255,.035);border:1px solid #33303a;border-radius:13px;padding:0 14px;color:#77717f;transition:border-color .2s,box-shadow .2s}
.scene-signup-input-wrap:focus-within{border-color:#a95afd;box-shadow:0 0 0 3px rgba(153,76,236,.11)}
.scene-signup-input-wrap input{font:inherit;font-size:13px;font-weight:500;color:white;min-width:0;width:100%;background:transparent;border:0;outline:0;height:100%}
.scene-signup-input-wrap input::placeholder{color:#67616f}
.scene-signup-input-wrap small{font-size:10px;white-space:nowrap}
.scene-signup-message{font-size:10px;font-weight:500}
.scene-signup-message.error{color:#ff8c9a}.scene-signup-message.success{color:#7ed7a0}.scene-signup-message.neutral{color:#81778d}
.scene-signup-language{border:1px solid #30253a;background:rgba(129,52,179,.07);border-radius:14px;padding:11px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.scene-signup-language>span{font-size:12px;color:#c1b6d0;font-weight:650}
.scene-signup-language-options{display:flex;gap:6px}
.scene-signup-language-options button{min-width:78px;padding:9px;border-radius:9px;background:#1a1821;color:#a7a0af;border:1px solid #302c38;cursor:pointer;font-size:12px;font-weight:700}
.scene-signup-language-options button.selected{background:#3a1a53;color:#fff;border-color:#ac53f3}
.scene-signup-primary{width:100%;height:52px;display:flex;align-items:center;justify-content:center;gap:12px;border:0;border-radius:12px;background:linear-gradient(110deg,#a350fb,#6d1dc5);font-size:14px;font-weight:750;color:white;cursor:pointer;margin-top:4px;box-shadow:0 12px 28px rgba(103,23,184,.25)}
.scene-signup-primary:hover:not(:disabled){filter:brightness(1.1)}.scene-signup-primary:disabled{opacity:.55;cursor:wait}
.scene-signup-divider{display:flex;align-items:center;gap:11px;margin:22px 0 17px}.scene-signup-divider span{height:1px;flex:1;background:#2b2531}.scene-signup-divider small{font-size:9px;font-weight:800;letter-spacing:.12em;color:#736b7e;white-space:nowrap}
.scene-signup-org-button{display:flex;align-items:center;gap:11px;width:100%;padding:15px;border-radius:12px;border:1px solid #473451;background:rgba(130,70,187,.09);color:#ebe2f4;font-weight:750;font-size:13px;cursor:pointer}
.scene-signup-org-button span{flex:1;text-align:left}.scene-signup-org-button:hover{background:rgba(130,70,187,.19);border-color:#9862ce}
.scene-signup-org-hint{text-align:center;color:#716979;font-size:10px;margin:10px 0 18px}
.scene-signup-login{text-align:center;color:#918999;font-size:12px;margin-top:17px}.scene-signup-login button{background:none;border:0;color:#c16cff;font:inherit;font-weight:750;cursor:pointer}
.scene-signup-footer{text-align:center;letter-spacing:.12em;font-size:10px;color:#645b6a;margin:17px 0}
.scene-signup-org-preview{display:flex;flex-direction:column;gap:15px}.scene-signup-text-back{align-self:flex-start;background:none;border:0;padding:0;display:flex;align-items:center;gap:6px;color:#a996bf;cursor:pointer;font-size:12px}
.scene-signup-org-symbol{height:58px;width:58px;display:flex;align-items:center;justify-content:center;border:1px solid #7f4f9e;border-radius:16px;color:#d1a5fa;background:rgba(120,47,180,.15);margin-top:10px}
.scene-signup-org-preview h2{line-height:1.15;margin:0}.scene-signup-org-preview>p{font-size:14px}
.scene-signup-org-features{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin:10px 0}.scene-signup-org-features span{display:flex;gap:7px;align-items:center;font-size:11px;color:#c0b1cf}.scene-signup-org-features svg{color:#ac6bf1;flex-shrink:0}
.scene-signup-info{display:flex;align-items:flex-start;gap:10px;padding:14px;border:1px solid #493653;border-radius:12px;background:rgba(124,76,170,.1);font-size:12px;line-height:1.5;color:#d1bfdc}.scene-signup-info svg{flex-shrink:0}
.scene-signup-spinner{animation:sceneSignupSpin .8s linear infinite}@keyframes sceneSignupSpin{to{transform:rotate(360deg)}}
@media(max-width:1050px){.scene-signup-layout{grid-template-columns:1fr 1fr;gap:2%;padding-left:4%;padding-right:4%}.scene-signup-card{padding:28px}.scene-signup-hero h1{font-size:clamp(42px,5vw,64px)}}
@media(max-width:780px){.scene-signup-layout{display:block;padding:100px 20px 35px}.scene-signup-hero{display:none}.scene-signup-right{max-width:520px;margin:auto}.scene-signup-card{padding:27px 21px;border-radius:21px}.scene-signup-back{left:20px;top:22px}.scene-signup-wall{left:-70%;width:210%;top:0;height:100%;opacity:.23;mask-image:linear-gradient(180deg,black,transparent 85%)}.scene-signup-grid{mask-image:none}}
@media(max-width:380px){.scene-signup-card{padding:23px 16px}.scene-signup-language{flex-direction:column;align-items:stretch}.scene-signup-language-options button{flex:1}}
@media(prefers-reduced-motion:reduce){.scene-signup-poster-row,.scene-signup-spinner{animation:none}}
