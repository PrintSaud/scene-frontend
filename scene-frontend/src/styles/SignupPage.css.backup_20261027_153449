html,
body,
#root {
  min-height: 100%;
}

body {
  margin: 0;
  background: #000;
}

.scene-signup-root {
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;

  display: flex;
  justify-content: center;
  align-items: flex-start;

  background: #000;

  padding:
    clamp(72px, 12vh, 145px)
    20px
    32px;

  color: #fff;
}

.scene-signup-panel {
  width: 100%;
  max-width: 520px;

  display: flex;
  flex-direction: column;
  align-items: center;

  box-sizing: border-box;
}

.scene-signup-title {
  margin: 0 0 8px;

  color: #fff;

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  font-size:
    clamp(28px, 5vw, 34px);

  line-height: 1.15;

  font-weight: 800;

  text-align: center;
}

.scene-signup-subtitle {
  max-width: 440px;

  margin:
    0
    0
    20px;

  padding: 0 10px;

  color: #8f8f98;

  font-size: 13px;
  line-height: 19px;

  text-align: center;
}

.scene-signup-error {
  width: 100%;

  margin-bottom: 14px;

  color: #ff4d4d;

  font-size: 13px;

  text-align: center;
}

.scene-signup-form {
  width: 100%;

  display: flex;
  flex-direction: column;
  align-items: center;
}

.scene-signup-avatar {
  width: 92px;
  height: 92px;

  border-radius: 50%;

  border:
    1.5px dashed
    rgba(
      179,
      39,
      246,
      0.75
    );

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 18px;

  overflow: hidden;

  cursor: pointer;

  background:
    rgba(
      255,
      255,
      255,
      0.025
    );

  transition:
    border-color 160ms ease,
    background 160ms ease,
    transform 160ms ease;
}

.scene-signup-avatar:hover {
  border-color: #b327f6;

  background:
    rgba(
      179,
      39,
      246,
      0.07
    );
}

.scene-signup-avatar:active {
  transform: scale(0.98);
}

.scene-signup-avatar-image {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}

.scene-signup-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 3px;

  color: #8f8f98;

  font-size: 10px;
  font-weight: 500;

  text-align: center;
}

.scene-signup-avatar-placeholder small {
  color: #666;

  font-size: 9px;
  font-weight: 500;
}

.scene-signup-field {
  width: 100%;
  margin-bottom: 10px;
}

.scene-signup-input-wrap {
  width: 100%;

  position: relative;
}

.scene-signup-input {
  width: 100%;
  min-height: 46px;

  box-sizing: border-box;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      0.1
    );

  border-radius: 12px;

  outline: none;

  background:
    rgba(
      255,
      255,
      255,
      0.035
    );

  color: #fff;

  padding:
    12px
    14px;

  font-family: inherit;
  font-size: 14px;

  transition:
    border-color 160ms ease,
    background 160ms ease;
}

.scene-signup-input::placeholder {
  color: #888;
}

.scene-signup-input:focus {
  border-color:
    rgba(
      179,
      39,
      246,
      0.75
    );

  background:
    rgba(
      255,
      255,
      255,
      0.05
    );
}

.scene-signup-checking {
  position: absolute;

  top: 50%;
  right: 14px;

  transform:
    translateY(-50%);

  color: #777;

  font-size: 11px;
}

.scene-signup-message {
  margin:
    6px
    4px
    0;

  font-size: 11px;
  line-height: 1.35;
}

.scene-signup-message.error {
  color: #ff6464;
}

.scene-signup-message.success {
  color: #76d98b;
}

.scene-signup-language {
  width: 100%;

  box-sizing: border-box;

  margin-top: 1px;
  margin-bottom: 6px;

  padding: 11px;

  border:
    1px solid
    rgba(
      150,
      90,
      255,
      0.16
    );

  border-radius: 12px;

  background:
    rgba(
      15,
      15,
      18,
      0.9
    );
}

.scene-signup-language-title {
  margin-bottom: 9px;

  color: #fff;

  font-size: 12px;
  font-weight: 600;

  text-align: center;
}

.scene-signup-language-buttons {
  display: flex;
  gap: 10px;
}

.scene-language-button {
  flex: 1;

  min-height: 38px;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      0.08
    );

  border-radius: 9px;

  background:
    rgba(
      255,
      255,
      255,
      0.03
    );

  color: #aaa;

  cursor: pointer;

  font-size: 13px;
  font-weight: 700;

  transition:
    border-color 160ms ease,
    background 160ms ease,
    color 160ms ease;
}

.scene-language-button.active {
  border-color: #b327f6;

  background:
    rgba(
      179,
      39,
      246,
      0.16
    );

  color: #fff;
}

.scene-signup-selected {
  width: 100%;

  margin-bottom: 10px;

  color: #777;

  font-size: 10px;

  text-align: center;
}

.scene-signup-submit {
  width: 100%;
  min-height: 46px;

  border: none;
  border-radius: 12px;

  background: #b327f6;

  color: #fff;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 14px;
  font-weight: 700;

  transition:
    opacity 160ms ease,
    transform 160ms ease;
}

.scene-signup-submit:hover:not(:disabled) {
  opacity: 0.92;
}

.scene-signup-submit:active:not(:disabled) {
  transform: scale(0.995);
}

.scene-signup-submit:disabled {
  opacity: 0.6;
  cursor: default;
}

.scene-signup-spinner {
  animation:
    scene-signup-spin
    0.8s
    linear
    infinite;
}

@keyframes scene-signup-spin {
  to {
    transform:
      rotate(360deg);
  }
}

.scene-signup-login {
  width: 100%;

  display: flex;
  justify-content: center;
  align-items: center;

  gap: 5px;

  margin-top: 14px;
  margin-bottom: 4px;

  color: #8a8a8a;

  font-size: 12px;
}

.scene-signup-login a {
  color: #b327f6;

  font-weight: 700;

  text-decoration: none;
}

.scene-signup-login a:hover {
  text-decoration: underline;
}

@media (
  max-width: 600px
) {
  .scene-signup-root {
    padding:
      76px
      20px
      28px;
  }

  .scene-signup-panel {
    max-width: 100%;
  }

  .scene-signup-title {
    font-size: 30px;
  }
}

@media (
  max-width: 380px
) {
  .scene-signup-root {
    padding-left: 16px;
    padding-right: 16px;
  }

  .scene-signup-language-buttons {
    gap: 8px;
  }
}
